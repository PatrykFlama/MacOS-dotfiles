# Ghostty config – reload with cmd+shift+, ; list options: `ghostty +show-config --default --docs`

font-family = JetBrainsMono Nerd Font Mono
font-size = 14

window-padding-x = 14
window-padding-y = 14
window-padding-balance = true
macos-titlebar-style = tabs

# Left Option acts as Alt (e.g. zsh Alt-C); left-Option + AeroSpace keys are taken by
# the window manager (Karabiner). Right Option still types
# Polish characters (ą ę ś ł ż ź ć ń ó) with the Polish Pro layout.
macos-option-as-alt = left

copy-on-select = clipboard
mouse-hide-while-typing = true
shell-integration-features = cursor,sudo,title

# Tokyo Night Moon (same palette as the tmux theme)
background = #222436
foreground = #c8d3f5
cursor-color = #c8d3f5
selection-background = #2d3f76
selection-foreground = #c8d3f5
palette = 0=#1b1d2b
palette = 1=#ff757f
palette = 2=#c3e88d
