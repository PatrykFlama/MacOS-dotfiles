#!/usr/bin/env bash
# tiling-toggle – switch between tiling (AeroSpace) and native macOS window behaviour.
# Bound to left ⌥⇧T via Karabiner, since a disabled AeroSpace ignores all its own keys.
#
#   tiling off: AeroSpace stops managing windows, SwipeAeroSpace quits, window borders
#               (JankyBorders) stop – they glitch in Mission Control –, the SwiftBar
#               workspace indicator hides, and the macOS
#               3-finger gestures (Spaces swipe, Mission Control) come back.
#   tiling on:  the reverse – borders + indicator back, 3-finger swipes go to SwipeAeroSpace.
#
# Note: `drs` re-applies the config defaults (3-finger gestures off), so rebuild while
# tiling is on, or toggle twice afterwards.
set -euo pipefail

aerospace=/opt/homebrew/bin/aerospace
swipe_app=club.mediosz.SwipeAeroSpace
# JankyBorders runs as a nix-darwin launchd agent with KeepAlive, so it must be
# unloaded/loaded (killing it would just restart it).
borders_agent="gui/$(id -u)/org.nixos.jankyborders"
borders_plist="$HOME/Library/LaunchAgents/org.nixos.jankyborders.plist"

# 0 = off, 2 = macOS default action (Spaces swipe / Mission Control).
set_native_three_finger_gestures() {
  local value=$1 domain
  for domain in com.apple.AppleMultitouchTrackpad com.apple.driver.AppleBluetoothMultitouch.trackpad; do
    defaults write "$domain" TrackpadThreeFingerHorizSwipeGesture -int "$value"
    defaults write "$domain" TrackpadThreeFingerVertSwipeGesture -int "$value"
  done
  # Apply without logging out.
  /System/Library/PrivateFrameworks/SystemAdministration.framework/Resources/activateSettings -u
}

if "$aerospace" enable off --fail-if-noop >/dev/null 2>&1; then
  state=off
  /usr/bin/osascript -e "tell application id \"$swipe_app\" to quit" >/dev/null 2>&1 || true
  launchctl bootout "$borders_agent" >/dev/null 2>&1 || true
  open -g "swiftbar://disableplugin?name=aerospace" >/dev/null 2>&1 || true
  set_native_three_finger_gestures 2
else
  "$aerospace" enable on
  state=on
  set_native_three_finger_gestures 0
  launchctl bootstrap "gui/$(id -u)" "$borders_plist" >/dev/null 2>&1 || true
  open -g -b "$swipe_app"
  open -g "swiftbar://enableplugin?name=aerospace" >/dev/null 2>&1 || true
fi

/usr/bin/osascript -e "display notification \"Tiling: ${state}\" with title \"AeroSpace\""
